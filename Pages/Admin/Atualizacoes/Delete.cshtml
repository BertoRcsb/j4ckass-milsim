@page
@model AtualizacoesDeleteModel
@{
    ViewData["Title"] = "Deletar Atualização";
}

<div class="page-hero page-hero-admin">
    <div class="app-container">
        <h1 class="page-title">DELETAR ATUALIZAÇÃO</h1>
        <p>Remover versão permanentemente</p>
    </div>
</div>

<section class="content-section">
    <div class="app-container">
        <div class="form-panel" style="max-width: 600px;">
            @if (Model.Atualizacao != null)
            {
                <div class="alert alert-danger" role="alert">
                    <strong>Atenção!</strong> Esta ação é irreversível. Tem certeza que deseja deletar esta atualização?
                </div>

                <div style="background: var(--color-surface); padding: 16px; border-radius: 8px; margin-bottom: 24px;">
                    <h4>@Model.Atualizacao.Versao</h4>
                    <p>@Model.Atualizacao.Conteudo</p>
                    <small>Criada em @Model.Atualizacao.DataCriacao.ToString("dd/MM/yyyy HH:mm")</small>
                </div>

                <form method="post" style="display: flex; gap: 12px;">
                    <button type="submit" class="btn btn-danger">CONFIRMAR DELEÇÃO</button>
                    <a href="/Admin/Atualizacoes/Index" class="btn btn-outline-light">CANCELAR</a>
                </form>
            }
            else
            {
                <div class="alert alert-warning">
                    Atualização não encontrada.
                    <a href="/Admin/Atualizacoes/Index">Voltar para lista</a>
                </div>
            }
        </div>
    </div>
</section>
