@page
@model AtualizacoesIndexModel
@{
    ViewData["Title"] = "Gerenciar Atualizações";
}

<div class="page-hero page-hero-admin">
    <div class="app-container">
        <h1 class="page-title">ATUALIZAÇÕES</h1>
        <p>Gerenciar versões do projeto</p>
    </div>
</div>

<section class="content-section">
    <div class="app-container">
        <div style="margin-bottom: 24px;">
            <a href="/Admin/Atualizacoes/Create" class="btn btn-primary">+ NOVA ATUALIZAÇÃO</a>
            <a href="/Admin/Dashboard" class="btn btn-outline-light">VOLTAR</a>
        </div>

        @if (Model.Atualizacoes.Any())
        {
            <div style="overflow-x: auto;">
                <table class="table table-dark table-striped">
                    <thead>
                        <tr>
                            <th>Versão</th>
                            <th>Criada em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var atualizacao in Model.Atualizacoes)
                        {
                            <tr>
                                <td>@atualizacao.Versao</td>
                                <td>@atualizacao.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a href="/Admin/Atualizacoes/Edit?id=@atualizacao.Id" class="btn btn-sm btn-warning">Editar</a>
                                    <a href="/Admin/Atualizacoes/Delete?id=@atualizacao.Id" class="btn btn-sm btn-danger">Deletar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                Nenhuma atualização cadastrada. <a href="/Admin/Atualizacoes/Create">Criar a primeira atualização</a>
            </div>
        }
    </div>
</section>

<style>
    .table {
        background: var(--color-surface);
        border-color: var(--color-border);
    }

    .table th {
        border-color: var(--color-border);
        background: var(--color-surface-strong);
    }

    .table td {
        border-color: var(--color-border);
        vertical-align: middle;
    }

    .btn-warning {
        background: #d4a574;
        border-color: #d4a574;
        color: #000;
    }

    .btn-warning:hover {
        background: #e0b588;
        border-color: #e0b588;
    }

    .btn-danger {
        background: #c1311a;
        border-color: #c1311a;
    }

    .btn-danger:hover {
        background: #e84432;
        border-color: #e84432;
    }
</style>
