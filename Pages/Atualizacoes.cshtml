@page
@model AtualizacoesModel
@{
    ViewData["Title"] = "Atualizações";
}

<section class="page-hero page-hero-updates">
    <div class="app-container">
        <p class="eyebrow">Melhorias e novidades</p>
        <h1 class="page-title">Atualizações</h1>
        <p>Acompanhe o desenvolvimento e as melhorias trazidas ao portal e às operações do grupo.</p>
    </div>
</section>

<section class="content-section">
    <div class="app-container">
        @if (Model.Atualizacoes.Any())
        {
            <div class="updates-timeline">
                @foreach (var atualizacao in Model.Atualizacoes)
                {
                    <article class="update-card">
                        <div class="update-header">
                            <h2>@atualizacao.Versao</h2>
                            <span class="update-version">@atualizacao.Versao</span>
                        </div>
                        <time class="update-date">@atualizacao.DataCriacao.ToString("dd/MM/yyyy")</time>
                        <p>@atualizacao.Conteudo</p>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info" style="padding: 24px; border-radius: 8px;">
                <p>Nenhuma atualização publicada no momento. Volte em breve!</p>
            </div>
        }
    </div>
</section>

<section class="content-section bg-light">
    <div class="app-container">
        <h2 class="section-title">Tenha sugestões?</h2>
        <p>Sua opinião é importante. Compartilhe ideias de melhorias e novas funcionalidades no canal #sugestões do Discord.</p>
    </div>
</section>
