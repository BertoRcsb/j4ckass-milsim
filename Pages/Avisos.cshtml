@page
@model AvisosModel
@{
    ViewData["Title"] = "Avisos";
}

<section class="page-hero page-hero-announcements">
    <div class="app-container">
        <p class="eyebrow">Comunicados importantes</p>
        <h1 class="page-title">Avisos</h1>
        <p>Fique atualizado com os últimos comunicados, eventos e informações essenciais da comunidade.</p>
    </div>
</section>

<section class="content-section">
    <div class="app-container">
        @if (Model.Avisos.Any())
        {
            <div class="announcements-list">
                @foreach (var aviso in Model.Avisos)
                {
                    <article class="announcement-card">
                        <div class="announcement-meta">
                            <span class="announcement-date">@aviso.DataCriacao.ToString("dd/MM/yyyy")</span>
                            <span class="announcement-badge badge-important">Aviso</span>
                        </div>
                        <h2>@aviso.Titulo</h2>
                        <p>@aviso.Conteudo</p>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info" style="padding: 24px; border-radius: 8px;">
                <p>Nenhum aviso publicado no momento. Volte em breve para atualizações!</p>
            </div>
        }
    </div>
</section>

<section class="content-section bg-light">
    <div class="app-container text-center">
        <h2 class="section-title">Quer sugerir um comunicado?</h2>
        <p>Entre em contato com a liderança no Discord ou envie uma mensagem privada a qualquer moderador.</p>
    </div>
</section>
